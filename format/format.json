        ],
        "packages": [
          "LayerHash",
          "LayerIndex",
          "MajorVersion",
          "PackageHash",
          "PackageProvider",
          "PackageSource",
          "Product",
          "SoftwareArchitecture",
          "Status",
          "Vendor"
        ]
      }
    }
  },
  "/kubernetes-protection/entities/kubernetes/clusters/v1": {
    "get": {
      "query": [
        "cluster_names",
        "status",
        "account_ids",
        "locations",
        "cluster_service",
        "limit",
        "offset"
      ]
    }
  }
}